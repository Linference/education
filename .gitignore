# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
out/
build/
*.tsbuildinfo

# 格致的数据（绝不入库）
*.db
*.db-wal
*.db-shm
.gezhi/
%APPDATA%/

# PoC 的可再生部分
poc/*/node_modules/
poc/*/dist/

# 临时与探针产物
*.tmp
*.tmpdir/
.selfcheck.*
_probe_*

# 密钥：任何形式的凭据都不许提交
.env
.env.*
*.key
credentials*.yaml
credentials*.json

# 编辑器与系统
.vscode/*
!.vscode/extensions.json
.idea/
Thumbs.db
desktop.ini

# 生成物（可从模板重新编译）
产出/


# 提交信息临时文件
.commit-msg-tmp.txt


# 语音测试产物
packages/voice/out/


# 构建产物
dist/


# 内置二进制（用 node scripts/vendor-typst.mjs 准备）
vendor/typst/*.exe

# 内置的 LibreOffice（1 GB / 9000+ 文件，**绝不入库**）
#
# 为什么不入库：
#   1. 体积 —— 1 GB 的二进制进 git 会把仓库撑爆，且每次改动都留下历史
#   2. 可复现 —— 它是从官方 MSI 解包 + 裁剪得到的，不是源码
#      （制备步骤见 vendor/soffice/README.md）
#   3. 许可 —— 这是第三方程序，仓库里只该放"怎么获取它"的说明，
#      不该重新分发一份（分发发生在安装包里，那里带了许可文件）
#
# 但 README.md 与许可说明要**入库** —— 它们记录了裁剪依据与 MPL-2.0 义务，
# 是给别人看的关键信息。所以用取反规则单独放行。
vendor/soffice/*
!vendor/soffice/README.md


