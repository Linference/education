{
  "name": "gezhi",
  "version": "0.0.1",
  "private": true,
  "type": "module",
  "description": "格致 —— 本地优先的个人学习操作系统（知识库 / AI 陪练 / 题库组卷 / 日历计划）",
  "packageManager": "pnpm@11.7.0",
  "engines": {
    "node": ">=22.5.0"
  },
  "scripts": {
    "check:license": "node scripts/check-licenses.mjs",
    "check:license:test": "node scripts/check-licenses.test.mjs",
    "check:secrets": "node scripts/scan-secrets.mjs",
    "check:secrets:test": "node scripts/scan-secrets.test.mjs",
    "check:mojibake": "node scripts/scan-mojibake.mjs .",
    "db:assert": "node packages/db/src/assert-schema.mjs",
    "db:init": "node packages/db/src/cli.mjs",
    "db:where": "node packages/db/src/cli.mjs where",
    "dsh:smoke": "node packages/dsh-bridge/smoke.mjs",
    "p0": "node scripts/p0.mjs",
    "ui:smoke": "node apps/desktop/smoke-electron.mjs",
    "ui:verify": "node apps/desktop/verify-markdown.mjs",
    "ui:verify:render": "node apps/desktop/verify-render.mjs",
    "ui:verify:docx": "node apps/desktop/verify-docx.mjs",
    "ui:verify:ai": "node apps/desktop/verify-ai.mjs",
    "ui:verify:packaged": "node apps/desktop/verify-packaged.mjs",
    "ui:verify:export": "node apps/desktop/verify-export-ui.mjs",
    "ui:verify:export:packed": "node apps/desktop/verify-packaged-export.mjs",
    "ui:verify:doc": "node apps/desktop/verify-doc.mjs",
    "doc:test": "node scripts/doc-extract.test.cjs",
    "export:verify": "node scripts/verify-export.mjs",
    "export:latex:test": "node scripts/latex2typst.test.cjs",
    "export:isolate": "node scripts/_isolate-typst.mjs",
    "installer": "node scripts/build-installer.mjs"
  },
  "devDependencies": {
    "docx": "^9.8.1",
    "electron-builder": "^26.15.3",
    "playwright": "^1.63.0"
  },
  "build": {
    "appId": "mo.gezhi.app",
    "productName": "格致",
    "copyright": "Copyright 2026 Linference",
    "directories": {
      "app": "apps/desktop",
      "output": "dist/installer",
      "buildResources": "brand/assets"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "package.json",
      "!**/*.map"
    ],
    "extraResources": [
      {
        "from": "packages/dsh-bridge/src",
        "to": "dsh-bridge"
      },
      {
        "from": "templates/typst",
        "to": "templates/typst"
      },
      {
        "from": "templates/docx",
        "to": "templates/docx"
      },
      {
        "from": "vendor/typst",
        "to": "typst"
      }
    ],
    "asar": true,
    "compression": "maximum",
    "artifactName": "${productName}-${version}-安装包.${ext}",
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "brand/assets/app.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": true,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "格致",
      "installerLanguages": [
        "zh_TW",
        "zh_CN",
        "en_US"
      ],
      "multiLanguageInstaller": true,
      "displayLanguageSelector": true,
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "installerIcon": "brand/assets/app.ico",
      "uninstallerIcon": "brand/assets/app.ico",
      "installerHeaderIcon": "brand/assets/app.ico",
      "include": "build/installer.nsh"
    }
  },
  "author": "Linference <linjie20091027@gmail.com>",
  "license": "MIT"
}
