// Chinese handout template (handout)
//
// Usage:
//   typst compile --root . templates/typst/handout.typ output/handout.pdf
// or import it at the top of a file with #import and call handout.with(...)
//
// ★ Output must be clean (product requirement):
//   Generated PDF / Word / Markdown **must not contain any product attribution** —
//   not in the footer, not at the end, not in the header, not even in comments.
//   Students should receive "their own document", not "a document generated by
//   some software". So this template writes no author and no branding by default;
//   the `author` parameter is kept but **defaults to empty** and only appears in
//   the footer when the caller explicitly passes it (e.g. a student's own name).
//   ⚠ This only constrains **output**; the project name may appear in code
//   comments and repository docs.
//
// Design constraints:
//   - Layout must be decided by the template, the model only decides content → the same Markdown exported twice must have identical layout
//   - Chinese text must not show tofu boxes (the font stack has fallbacks)
//   - Math, code blocks, tables, and page numbers must all render correctly

#import "gezhi.typ": gezhi-fonts, gezhi-sans, gezhi-mono

#let handout(
  title: "Untitled Handout",
  subtitle: none,
  author: none,          // ← empty by default: no attribution, no watermark
  subject: none,
  grade: none,
  date: none,
  body,
) = {
  // weight must be written explicitly as "regular"; otherwise Typst may pick the Thin/ExtraLight face
  set text(font: gezhi-fonts, size: 10.5pt, weight: "regular", lang: "zh", region: "cn")
  set par(justify: true, leading: 0.82em, first-line-indent: 0em)
  set page(
    paper: "a4",
    margin: (x: 2.2cm, y: 2.4cm),
    // Header shows only the title and page number — the title is the student's content and the page number is useful information; neither is branding
    header: context {
      let page-num = counter(page).get().first()
      if page-num > 1 {
        set text(font: gezhi-sans, size: 8.5pt, weight: "regular", fill: luma(40%))
        grid(
          columns: (1fr, auto),
          align: (left, right),
          [#title],
          [#page-num],
        )
        v(-0.6em)
        line(length: 100%, stroke: 0.4pt + luma(80%))
      }
    },
    // Footer: shown only when the caller explicitly supplies an author (no footer by default)
    footer: if author == none { none } else {
      context {
        set text(font: gezhi-sans, size: 8.5pt, weight: "regular", fill: luma(45%))
        align(center)[#author]
      }
    },
  )

  // Title area
  // Note: no "subject/grade" category line — a topic should not be boxed in by
  // arts/science divisions; when labeling is needed, express it freely in the
  // subtitle (e.g. "Monotonicity of functions · with examples and pitfalls").
  align(center)[
    #text(font: gezhi-sans, size: 19pt, weight: "bold")[#title]
    #if subtitle != none [
      #v(0.25em)
      #text(font: gezhi-sans, size: 11pt, fill: luma(35%))[#subtitle]
    ]
    #if date != none [
      #v(0.4em)
      #text(font: gezhi-sans, size: 9pt, fill: luma(45%))[#date]
    ]
  ]
  v(1.1em)
  line(length: 100%, stroke: 0.6pt + luma(70%))
  v(0.9em)

  body
}

// Terminology / key-point callout — commonly used in handouts
#let tip(title: "Tip", body) = block(
  width: 100%,
  inset: (x: 0.9em, y: 0.7em),
  radius: 3pt,
  stroke: (left: 2.5pt + rgb("#0969da")),
  fill: rgb("#f2f7fd"),
)[
  #text(font: gezhi-sans, weight: "bold", fill: rgb("#0a3069"))[#title]
  #v(0.35em)
  #body
]

// Common mistakes — for review scenarios
#let pitfall(title: "Pitfall", body) = block(
  width: 100%,
  inset: (x: 0.9em, y: 0.7em),
  radius: 3pt,
  stroke: (left: 2.5pt + rgb("#cf222e")),
  fill: rgb("#fdf3f3"),
)[
  #text(font: gezhi-sans, weight: "bold", fill: rgb("#a40e26"))[#title]
  #v(0.35em)
  #body
]

// Source citation — the output-layer expression of the mandatory-citation principle.
// What goes here is the **textbook title and page number**, not a product name —
// students should be able to take this line and check it against the book.
#let cite(source, page: none) = text(
  font: gezhi-sans,
  size: 8.5pt,
  fill: luma(45%),
)[#source#if page != none [ · p. #page]]

// ------------------------------------------------------------------
// The components below satisfy the "topics must be detailed" requirement.
// A definition alone is not enough for a topic: derivations, worked examples,
// common mistakes, comparisons, and self-checks all need a place to go.
// Let the AI choose them as needed rather than cramming every handout —
// but **an outline alone is not acceptable**.
// ------------------------------------------------------------------

/// Derivation: unfold step by step, every step needs a reason
#let derive(title: "Derivation", body) = block(
  width: 100%,
  inset: (x: 0.9em, y: 0.7em),
  radius: 3pt,
  stroke: (left: 2.5pt + rgb("#8250df")),
  fill: rgb("#faf5ff"),
)[
  #text(font: gezhi-sans, weight: "bold", fill: rgb("#6639ba"))[#title]
  #v(0.35em)
  #body
]

/// Worked example: problem statement + solution kept separate, so students can try first and check later
/// Note: stem is a **positional parameter** and must precede every named parameter in the signature —
/// Typst does not allow passing a positional parameter as `stem:` (it reports "the argument `stem` is positional").
#let example(
  stem,
  title: "Example",
  solution: none,
) = block(
  width: 100%,
  inset: (x: 0.9em, y: 0.7em),
  radius: 3pt,
  stroke: (left: 2.5pt + rgb("#1a7f37")),
  fill: rgb("#f6fdf8"),
)[
  #text(font: gezhi-sans, weight: "bold", fill: rgb("#116329"))[#title]
  #v(0.35em)
  #stem
  #if solution != none [
    #v(0.5em)
    #text(font: gezhi-sans, size: 9pt, fill: luma(45%))[Solution]
    #v(0.2em)
    #solution
  ]
]

/// Comparison table: put easily confused concepts side by side (e.g. must vs may, law of sines vs law of cosines)
#let compare(headers, rows) = table(
  columns: headers.len(),
  align: (left, left, left),
  stroke: 0.4pt + luma(75%),
  inset: 6pt,
  table.header(..headers.map(h => text(font: gezhi-sans, weight: "bold")[#h])),
  ..rows.flatten(),
)

/// Self-check: leave blank space for students to write (can be printed directly from the exported PDF)
#let selfcheck(items) = block(
  width: 100%,
  inset: (x: 0.9em, y: 0.7em),
  radius: 3pt,
  stroke: (left: 2.5pt + rgb("#9a6700")),
  fill: rgb("#fffdf5"),
)[
  #text(font: gezhi-sans, weight: "bold", fill: rgb("#7d4e00"))[Self-check]
  #v(0.35em)
  #enum(..items)
]
