#!/bin/sh
# Gezhi · pre-commit checks
#
# Why .githooks/ instead of .git/hooks/:
#   .git/ is not version-controlled — hooks placed there vanish when the repo is
#   cloned to another machine, which amounts to "only my machine is protected".
#   Pointing core.hooksPath at .githooks/ makes them truly shared.
#
# Install (once):
#   git config core.hooksPath .githooks
#
# Two gates:
#   ① Secret leak scan (most important: this project has been bitten twice)
#   ② License allowlist (AGPL / non-commercial / production-forbidden must never enter the dependency tree)

set -e

echo "── Pre-commit checks ──"

# ---------- ① Secret scan: only look at what is being committed ----------
STAGED=$(git diff --cached --name-only --diff-filter=ACM)
if [ -n "$STAGED" ]; then
  echo "[1/2] Scanning staged files for secrets…"
  # Use git show :file to read the staged version (not the working-tree version), so what is checked is exactly what will be committed
  TMPDIR_SEC=$(mktemp -d)
  trap 'rm -rf "$TMPDIR_SEC"' EXIT
  COUNT=0
  for f in $STAGED; do
    # Skip deleted files, binaries, and exceptions declared by the scanner itself
    case "$f" in
      *.png|*.jpg|*.jpeg|*.gif|*.webp|*.ico|*.pdf|*.zip|*.gz|*.woff|*.woff2|*.ttf|*.otf|*.mp3|*.mp4|*.db|*.asar) continue ;;
    esac
    mkdir -p "$TMPDIR_SEC/$(dirname "$f")"
    git show ":$f" > "$TMPDIR_SEC/$f" 2>/dev/null || continue
    COUNT=$((COUNT + 1))
  done

  if [ "$COUNT" -gt 0 ]; then
    if ! node scripts/scan-secrets.mjs "$TMPDIR_SEC" > "$TMPDIR_SEC/out.txt" 2>&1; then
      cat "$TMPDIR_SEC/out.txt"
      echo ""
      echo "✖ Commit rejected: suspected secret leak."
      echo "  Fix: ① revoke and reissue the secret  ② store the new secret in %APPDATA%\\gezhi\\credentials.enc"
      echo "       ③ if it is a false positive, add an exception in scripts/scan-secrets.mjs with a clear reason"
      echo "  Temporary bypass (not recommended): git commit --no-verify"
      exit 1
    fi
    tail -2 "$TMPDIR_SEC/out.txt"
  fi
else
  echo "[1/2] Staging area is empty, skipping secret scan"
fi

# ---------- ② License gate ----------
echo "[2/2] Checking dependency licenses…"
if ! node scripts/check-licenses.mjs > /tmp/gezhi-lic.txt 2>&1; then
  cat /tmp/gezhi-lic.txt
  echo ""
  echo "✖ Commit rejected: license risk in the dependency tree."
  exit 1
fi
tail -2 /tmp/gezhi-lic.txt

echo "── Checks passed ──"
